{
  "compilerOptions": {
    "strict": true,
    "noEmit": false,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "rootDir": ".",
    "outDir": ".build",
    "resolveJsonModule": true
  },
  "include": [
    "extensions/self-review/test/**/*.mts",
    "extensions/self-review/scripts/**/*.mts",
    "docs/screenshots/**/*.mts",
    "docs/screenshots/**/*.d.ts"
  ]
}
